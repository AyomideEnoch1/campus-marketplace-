datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  VENDOR
  BUYER
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProductCondition {
  NEW
  USED_LIKE_NEW
  USED_GOOD
  USED_FAIR
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  FLAGGED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  FLAGGED
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  role          Role      @default(BUYER)
  fullName      String
  phone         String?
  avatarUrl     String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  vendorProfile  VendorProfile?
  orders         Order[]
  favorites      Favorite[]
  reports        Report[]
  activityLogs   ActivityLog[]
  productReviews ProductReview[]     @relation("BuyerProductReviews")
  sellerRatings  SellerRating[]      @relation("BuyerSellerRatings")
  helpfulVotes   ReviewHelpfulVote[]
  reviewReports  ReviewReport[]
  vouchesGiven   Vouch[]             @relation("UserVouches")

  @@index([role])
  @@index([email])
}

model VendorProfile {
  id               String       @id @default(cuid())
  userId           String       @unique
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  campusId         String
  campus           Campus       @relation(fields: [campusId], references: [id])
  storeName        String
  slug             String       @unique
  storeDescription String?
  logo             String?
  banner           String?
  layout           String       @default("grid")
  brandColor       String       @default("#0F172A")
  whatsapp         String
  faculty          String?
  department       String?
  studentIdUrl     String?
  sellerType       String       @default("student") // student | guest
  verificationTier Int          @default(1) // 1: instant OTP, 2: manual ID review, 3: bank, 4: earned trust
  businessName     String?
  businessCategory String?
  businessAddress  String?
  businessPhotoPath String?
  cacNumber        String?
  cacDocumentPath  String?
  isRegisteredBusiness Boolean   @default(false)
  governmentIdType String?      // voters_card, drivers_license, international_passport, school_work_id
  governmentIdHash String?      // SHA-256 hash for duplicate check
  idDocumentPath   String?
  selfieDocumentPath String?
  vouchedBy        String?      // User/Vendor ID who vouched
  isTrustedSeller  Boolean      @default(false)
  payoutDelayHours Int          @default(48) // 48h for students, 72h for new guests
  bankAccountName  String?
  bankAccountNumber String?
  bankCode         String?
  bankName         String?
  bankResolvedName String?
  bankVerified     Boolean      @default(false)
  strikesCount     Int          @default(0)
  status           VendorStatus @default(PENDING)
  rejectionReason  String?
  adminNotes       String?
  sellerAvgRating  Float        @default(0.0)
  sellerReviewCount Int         @default(0)
  communicationAvg Float        @default(0.0)
  punctualityAvg   Float        @default(0.0)
  behaviorAvg      Float        @default(0.0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  products               Product[]
  orders                 Order[]
  receivedProductReviews ProductReview[] @relation("SellerProductReviews")
  receivedSellerRatings  SellerRating[]  @relation("SellerRatingsReceived")
  reviewReplies          ReviewReply[]
  vouchesReceived        Vouch[]         @relation("GuestVouches")

  @@index([slug])
  @@index([campusId])
  @@index([status])
  @@index([sellerType])
  @@index([governmentIdHash])
}

model Campus {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  city      String
  state     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendors          VendorProfile[]
  settings         CampusSetting?
  safeMeetupPoints SafeMeetupPoint[]

  @@index([slug])
  @@index([isActive])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  icon        String?
  image       String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Category[] @relation("CategoryHierarchy")
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  products Product[]

  @@index([slug])
  @@index([parentId])
}

model Product {
  id              String           @id @default(cuid())
  vendorId        String
  vendor          VendorProfile    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category         @relation(fields: [categoryId], references: [id])
  title           String
  slug            String           @unique
  description     String
  price           Float
  comparePrice    Float?
  stock           Int              @default(1)
  condition       ProductCondition @default(NEW)
  status          ProductStatus    @default(DRAFT)
  model3dUrl      String?
  videoUrl        String?
  tags            String?
  viewsCount      Int              @default(0)
  isFeatured      Boolean          @default(false)
  reviewCount     Int              @default(0)
  avgRating       Float            @default(0.0)
  ratingBreakdown String?          // JSON string e.g. {"5":0,"4":0,"3":0,"2":0,"1":0}
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  images         ProductImage[]
  variants       ProductVariant[]
  orderItems     OrderItem[]
  productReviews ProductReview[]
  favorites      Favorite[]
  reports        Report[]

  @@index([slug])
  @@index([vendorId])
  @@index([categoryId])
  @@index([status])
  @@index([price])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  position  Int      @default(0)
  altText   String?
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([position])
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String
  value           String
  priceAdjustment Float    @default(0)
  stock           Int      @default(0)
  sku             String?
  createdAt       DateTime @default(now())

  @@index([productId])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  buyerId         String?
  buyer           User?       @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  buyerName       String
  buyerEmail      String
  buyerPhone      String
  deliveryAddress String
  deliveryMethod  String      @default("PICKUP")
  vendorId        String
  vendor          VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  status          OrderStatus @default(PENDING)
  totalAmount     Float
  notes           String?
  meetupPointId   String?
  meetupPoint     SafeMeetupPoint? @relation(fields: [meetupPointId], references: [id], onDelete: SetNull)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items         OrderItem[]
  sellerRatings SellerRating[]

  @@index([orderNumber])
  @@index([vendorId])
  @@index([buyerId])
  @@index([status])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity       Int      @default(1)
  unitPrice      Float
  variantDetails String?
  createdAt      DateTime @default(now())

  review ProductReview?

  @@index([orderId])
  @@index([productId])
}

model ProductReview {
  id           String       @id @default(cuid())
  orderItemId  String       @unique
  orderItem    OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  productId    String
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyerId      String
  buyer        User         @relation("BuyerProductReviews", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId     String
  seller       VendorProfile @relation("SellerProductReviews", fields: [sellerId], references: [id], onDelete: Cascade)
  rating       Int          @default(5)
  comment      String?
  tags         String?
  photoPaths   String?
  status       ReviewStatus @default(PUBLISHED)
  helpfulCount Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  helpfulVotes ReviewHelpfulVote[]
  reply        ReviewReply?
  reports      ReviewReport[]

  @@index([productId])
  @@index([sellerId])
  @@index([buyerId])
  @@index([status])
  @@index([createdAt])
}

model SellerRating {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyerId       String
  buyer         User          @relation("BuyerSellerRatings", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId      String
  seller        VendorProfile @relation("SellerRatingsReceived", fields: [sellerId], references: [id], onDelete: Cascade)
  communication Int           @default(5)
  punctuality   Int           @default(5)
  behavior      Int           @default(5)
  createdAt     DateTime      @default(now())

  @@unique([orderId, buyerId])
  @@index([sellerId])
}

model ReviewHelpfulVote {
  reviewId  String
  review    ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([reviewId, userId])
  @@index([reviewId])
}

model ReviewReply {
  id        String        @id @default(cuid())
  reviewId  String        @unique
  review    ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    VendorProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([reviewId])
}

model ReviewReport {
  id         String        @id @default(cuid())
  reviewId   String
  review     ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User          @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  details    String?
  status     ReportStatus  @default(PENDING)
  createdAt  DateTime      @default(now())

  @@index([reviewId])
  @@index([status])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model Report {
  id               String   @id @default(cuid())
  reportedByUserId String?
  reportedBy       User?    @relation(fields: [reportedByUserId], references: [id], onDelete: SetNull)
  productId        String?
  product          Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  reason           String
  details          String?
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([productId])
  @@index([status])
}

model Page {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  content         String
  isPublished     Boolean  @default(true)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
}

model Banner {
  id        String    @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String?
  linkUrl   String?
  position  String    @default("HOMEPAGE_HERO")
  isActive  Boolean   @default(true)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([position])
  @@index([isActive])
}

model HomepageSection {
  id          String   @id @default(cuid())
  sectionKey  String   @unique
  title       String?
  subtitle    String?
  contentJson String?
  sortOrder   Int      @default(0)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sectionKey])
  @@index([sortOrder])
}

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}

model ActivityLog {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String
  entityType   String
  entityId     String?
  metadataJson String?
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model CampusSetting {
  id                  String   @id @default(cuid())
  campusId            String   @unique
  campus              Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  guestVendorsEnabled Boolean  @default(true)
  guestVendorCap      Int      @default(50)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([campusId])
}

model SafeMeetupPoint {
  id          String   @id @default(cuid())
  campusId    String
  campus      Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      Order[]

  @@index([campusId])
  @@index([active])
}

model Vouch {
  id        String   @id @default(cuid())
  voucherId String
  voucher   User     @relation("UserVouches", fields: [voucherId], references: [id], onDelete: Cascade)
  guestId   String
  guest     VendorProfile @relation("GuestVouches", fields: [guestId], references: [id], onDelete: Cascade)
  status    String   @default("ACCEPTED") // PENDING | ACCEPTED | REVOKED
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([voucherId])
  @@index([guestId])
}
