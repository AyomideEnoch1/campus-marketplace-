datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPERADMIN
  ADMIN
  VENDOR
  BUYER
  AMBASSADOR
}

enum AmbassadorStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum ReferralRewardStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProductCondition {
  NEW
  USED_LIKE_NEW
  USED_GOOD
  USED_FAIR
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  FLAGGED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  FLAGGED
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum PromoDiscountType {
  PERCENTAGE
  FIXED
}

enum PromoStatus {
  SCHEDULED
  ACTIVE
  EXPIRED
  CANCELLED
}

enum VendorAccessState {
  UNPAID
  ACTIVE_PAID
  ACTIVE_COUPON
  EXPIRED
  RELEASED
}

enum CouponRedemptionStatus {
  ACTIVE
  EXPIRED
  RELEASED
  REVOKED
}

enum CouponReleaseReason {
  ADMIN_REJECTED
  INACTIVITY
  REVOKED
  EXPIRED
  PAID_UPGRADE
}

model User {
  id            String    @id @default(cuid())
  email         String
  passwordHash  String?
  role          Role      @default(BUYER)
  fullName      String
  phone         String?
  avatarUrl     String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  vendorProfile  VendorProfile?
  orders         Order[]
  favorites      Favorite[]
  reports        Report[]
  activityLogs   ActivityLog[]
  productReviews ProductReview[]     @relation("BuyerProductReviews")
  sellerRatings  SellerRating[]      @relation("BuyerSellerRatings")
  helpfulVotes   ReviewHelpfulVote[]
  reviewReports  ReviewReport[]
  vouchesGiven   Vouch[]             @relation("UserVouches")
  disputes       Dispute[]
  buyerConversations Conversation[] @relation("BuyerConversations")
  sentChatMessages   ChatMessage[]  @relation("UserSentMessages")
  notifications      Notification[]
  ambassadorProfile  AmbassadorProfile?
  referredBy         Referral?           @relation("ReferredUser")
  couponAuditLogs    CouponAuditLog[]
  emailPreference    EmailPreference?

  @@unique([email, role])
  @@index([role])
  @@index([email])
}

model VendorProfile {
  id               String       @id @default(cuid())
  userId           String       @unique
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  campusId         String
  campus           Campus       @relation(fields: [campusId], references: [id])
  storeName        String
  slug             String       @unique
  storeDescription String?
  logo             String?
  banner           String?
  layout           String       @default("grid")
  brandColor       String       @default("#0F172A")
  whatsapp         String
  faculty          String?
  department       String?
  studentIdUrl     String?
  sellerType       String       @default("student") // student | guest
  verificationTier Int          @default(1) // 1: instant OTP, 2: manual ID review, 3: bank, 4: earned trust
  businessName     String?
  businessCategory String?
  businessAddress  String?
  businessPhotoPath String?
  cacNumber        String?
  cacDocumentPath  String?
  isRegisteredBusiness Boolean   @default(false)
  governmentIdType String?      // nin, voters_card, drivers_license, international_passport, school_work_id
  governmentIdHash String?      // SHA-256 hash for duplicate check
  nin              String?      // 11-digit National Identity Number (NIN)
  idDocumentPath   String?
  selfieDocumentPath String?
  vouchedBy        String?      // User/Vendor ID who vouched
  isTrustedSeller  Boolean      @default(false)
  payoutDelayHours Int          @default(48) // 48h for students, 72h for new guests
  bankAccountName  String?
  bankAccountNumber String?
  bankCode         String?
  bankName         String?
  bankResolvedName String?
  bankVerified     Boolean      @default(false)
  strikesCount     Int          @default(0)
  status           VendorStatus @default(PENDING)
  rejectionReason  String?
  adminNotes       String?
  sellerAvgRating  Float        @default(0.0)
  sellerReviewCount Int         @default(0)
  communicationAvg Float        @default(0.0)
  punctualityAvg   Float        @default(0.0)
  behaviorAvg      Float        @default(0.0)
  accessState      VendorAccessState @default(UNPAID)
  accessExpiresAt  DateTime?
  accessActivatedAt DateTime?
  accessPaidAt     DateTime?
  approvedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  products               Product[]
  orders                 Order[]
  payouts                Payout[]
  sellerBankAccount      SellerBankAccount?
  receivedProductReviews ProductReview[] @relation("SellerProductReviews")
  receivedSellerRatings  SellerRating[]  @relation("SellerRatingsReceived")
  reviewReplies          ReviewReply[]
  vouchesReceived        Vouch[]         @relation("GuestVouches")
  vendorConversations    Conversation[]  @relation("VendorConversations")
  promotions             Promotion[]
  couponRedemptions      CouponRedemption[]

  @@index([slug])
  @@index([campusId])
  @@index([status])
  @@index([accessState])
  @@index([sellerType])
  @@index([governmentIdHash])
}

model Campus {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  city      String
  state     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendors          VendorProfile[]
  settings         CampusSetting?
  safeMeetupPoints SafeMeetupPoint[]
  ambassadors      AmbassadorProfile[]

  @@index([slug])
  @@index([isActive])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  icon        String?
  image       String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Category[] @relation("CategoryHierarchy")
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  products Product[]

  @@index([slug])
  @@index([parentId])
}

model Product {
  id              String           @id @default(cuid())
  vendorId        String
  vendor          VendorProfile    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category         @relation(fields: [categoryId], references: [id])
  title           String
  slug            String           @unique
  description     String
  price           Float
  comparePrice    Float?
  stock           Int              @default(1)
  condition       ProductCondition @default(NEW)
  status          ProductStatus    @default(DRAFT)
  model3dUrl      String?
  videoUrl        String?
  tags            String?
  viewsCount      Int              @default(0)
  isFeatured      Boolean          @default(false)
  reviewCount     Int              @default(0)
  avgRating       Float            @default(0.0)
  ratingBreakdown String?          // JSON string e.g. {"5":0,"4":0,"3":0,"2":0,"1":0}
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  images         ProductImage[]
  variants       ProductVariant[]
  orderItems     OrderItem[]
  productReviews ProductReview[]
  favorites      Favorite[]
  reports        Report[]
  conversations  Conversation[]
  promotions     Promotion[]

  @@index([slug])
  @@index([vendorId])
  @@index([categoryId])
  @@index([status])
  @@index([price])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  position  Int      @default(0)
  altText   String?
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([position])
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String
  value           String
  priceAdjustment Float    @default(0)
  stock           Int      @default(0)
  sku             String?
  createdAt       DateTime @default(now())

  @@index([productId])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  buyerId         String?
  buyer           User?       @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  buyerName       String
  buyerEmail      String
  buyerPhone      String
  deliveryAddress String
  deliveryMethod  String      @default("PICKUP")
  vendorId        String
  vendor          VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  status          OrderStatus @default(PENDING)
  totalAmount     Float
  tx_ref          String?     @unique
  escrow_status   String      @default("pending")
  escrow_mode     String      @default("escrow") // escrow | direct
  escrow_forced_reason String?
  fee_amount      Float       @default(0.0)
  fee_percent     Float       @default(0.0)
  fee_payer       String      @default("buyer") // buyer | seller | split
  settings_snapshot String?   // JSON snapshot of platform settings at order creation
  subtotal        Float       @default(0.0)
  commission      Float       @default(0.0)
  seller_amount   Float       @default(0.0)
  currency        String      @default("NGN")
  flw_transaction_id String?
  paid_at         DateTime?
  delivered_at    DateTime?
  confirmed_at    DateTime?
  released_at     DateTime?
  auto_release_at DateTime?
  dispute_deadline DateTime?
  notes           String?
  meetupPointId   String?
  meetupPoint     SafeMeetupPoint? @relation(fields: [meetupPointId], references: [id], onDelete: SetNull)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items         OrderItem[]
  sellerRatings SellerRating[]
  payments      Payment[]
  payouts       Payout[]
  escrowLedger  EscrowLedger[]
  deliveryCode  DeliveryCode?
  dispute       Dispute?
  refunds       Refund[]

  @@index([orderNumber])
  @@index([tx_ref])
  @@index([escrow_status])
  @@index([vendorId])
  @@index([buyerId])
  @@index([status])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity       Int      @default(1)
  unitPrice      Float
  variantDetails String?
  createdAt      DateTime @default(now())

  review ProductReview?

  @@index([orderId])
  @@index([productId])
}

model ProductReview {
  id           String       @id @default(cuid())
  orderItemId  String       @unique
  orderItem    OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  productId    String
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyerId      String
  buyer        User         @relation("BuyerProductReviews", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId     String
  seller       VendorProfile @relation("SellerProductReviews", fields: [sellerId], references: [id], onDelete: Cascade)
  rating       Int          @default(5)
  comment      String?
  tags         String?
  photoPaths   String?
  status       ReviewStatus @default(PUBLISHED)
  helpfulCount Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  helpfulVotes ReviewHelpfulVote[]
  reply        ReviewReply?
  reports      ReviewReport[]

  @@index([productId])
  @@index([sellerId])
  @@index([buyerId])
  @@index([status])
  @@index([createdAt])
}

model SellerRating {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyerId       String
  buyer         User          @relation("BuyerSellerRatings", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId      String
  seller        VendorProfile @relation("SellerRatingsReceived", fields: [sellerId], references: [id], onDelete: Cascade)
  communication Int           @default(5)
  punctuality   Int           @default(5)
  behavior      Int           @default(5)
  createdAt     DateTime      @default(now())

  @@unique([orderId, buyerId])
  @@index([sellerId])
}

model ReviewHelpfulVote {
  reviewId  String
  review    ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([reviewId, userId])
  @@index([reviewId])
}

model ReviewReply {
  id        String        @id @default(cuid())
  reviewId  String        @unique
  review    ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    VendorProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([reviewId])
}

model ReviewReport {
  id         String        @id @default(cuid())
  reviewId   String
  review     ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User          @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  details    String?
  status     ReportStatus  @default(PENDING)
  createdAt  DateTime      @default(now())

  @@index([reviewId])
  @@index([status])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model Report {
  id               String   @id @default(cuid())
  reportedByUserId String?
  reportedBy       User?    @relation(fields: [reportedByUserId], references: [id], onDelete: SetNull)
  productId        String?
  product          Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  reason           String
  details          String?
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([productId])
  @@index([status])
}

model Page {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  content         String
  isPublished     Boolean  @default(true)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
}

model Banner {
  id        String    @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String?
  linkUrl   String?
  position  String    @default("HOMEPAGE_HERO")
  isActive  Boolean   @default(true)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([position])
  @@index([isActive])
}

model HomepageSection {
  id          String   @id @default(cuid())
  sectionKey  String   @unique
  title       String?
  subtitle    String?
  contentJson String?
  sortOrder   Int      @default(0)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sectionKey])
  @@index([sortOrder])
}

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}

model ActivityLog {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String
  entityType   String
  entityId     String?
  metadataJson String?
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model CampusSetting {
  id                  String   @id @default(cuid())
  campusId            String   @unique
  campus              Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  guestVendorsEnabled Boolean  @default(true)
  guestVendorCap      Int      @default(50)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([campusId])
}

model SafeMeetupPoint {
  id          String   @id @default(cuid())
  campusId    String
  campus      Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      Order[]

  @@index([campusId])
  @@index([active])
}

model Vouch {
  id        String   @id @default(cuid())
  voucherId String
  voucher   User     @relation("UserVouches", fields: [voucherId], references: [id], onDelete: Cascade)
  guestId   String
  guest     VendorProfile @relation("GuestVouches", fields: [guestId], references: [id], onDelete: Cascade)
  status    String   @default("ACCEPTED") // PENDING | ACCEPTED | REVOKED
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([voucherId])
  @@index([guestId])
}

model Payment {
  id                String   @id @default(cuid())
  orderId           String   @map("order_id")
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  flwTransactionId  String   @unique @map("flw_transaction_id")
  txRef             String   @unique @map("tx_ref")
  amount            Float
  currency          String   @default("NGN")
  status            String   // successful, failed
  paymentType       String?  @map("payment_type")
  rawVerifyResponse String?  @map("raw_verify_response") // JSON string
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("payments")
  @@index([orderId])
  @@index([flwTransactionId])
  @@index([txRef])
}

model Payout {
  id            String        @id @default(cuid())
  orderId       String        @map("order_id")
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId      String        @map("seller_id")
  seller        VendorProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  amount        Float
  reference     String        @unique // payout_orderId_attempt
  flwTransferId String?       @map("flw_transfer_id")
  status        String        @default("pending") // pending, processing, successful, failed, reversed
  failureReason String?       @map("failure_reason")
  attempts      Int           @default(1)
  nextRetryAt   DateTime?     @map("next_retry_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  completedAt   DateTime?     @map("completed_at")

  @@map("payouts")
  @@index([orderId])
  @@index([sellerId])
  @@index([reference])
  @@index([status])
}

model EscrowLedger {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type        String   // escrow_in, commission, escrow_out, refund_out, adjustment
  amount      Float
  currency    String   @default("NGN")
  reference   String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("escrow_ledger")
  @@index([orderId])
  @@index([type])
  @@index([reference])
  @@index([createdAt])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String   @default("flutterwave")
  eventId     String   @unique @map("event_id")
  eventType   String   @map("event_type")
  payload     String   // JSON string
  status      String   @default("processed") // processed, ignored, failed
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("webhook_events")
  @@index([eventId])
  @@index([eventType])
}

model DeliveryCode {
  id        String   @id @default(cuid())
  orderId   String   @unique @map("order_id")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  locked    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("delivery_codes")
  @@index([orderId])
}

model Dispute {
  id                  String    @id @default(cuid())
  orderId             String    @unique @map("order_id")
  order               Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyerId             String    @map("buyer_id")
  buyer               User      @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  reason              String
  description         String
  evidencePaths       String?   @map("evidence_paths") // JSON string
  status              String    @default("open") // open, under_review, resolved_refund, resolved_release, resolved_split
  resolution          String?   // refund, release, split
  resolutionNotes     String?   @map("resolution_notes")
  refundAmount        Float?    @default(0.0) @map("refund_amount")
  sellerReleaseAmount Float?    @default(0.0) @map("seller_release_amount")
  resolvedAt          DateTime? @map("resolved_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  refunds Refund[]

  @@map("disputes")
  @@index([orderId])
  @@index([buyerId])
  @@index([status])
}

model Refund {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  disputeId   String?  @map("dispute_id")
  dispute     Dispute? @relation(fields: [disputeId], references: [id], onDelete: SetNull)
  amount      Float
  flwRefundId String?  @map("flw_refund_id")
  status      String   @default("pending") // pending, successful, failed
  reason      String
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("refunds")
  @@index([orderId])
  @@index([disputeId])
}

model SellerBankAccount {
  id            String        @id @default(cuid())
  sellerId      String        @unique @map("seller_id")
  seller        VendorProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  bankCode      String        @map("bank_code")
  bankName      String        @map("bank_name")
  accountNumber String        @map("account_number")
  accountName   String        @map("account_name")
  verified      Boolean       @default(false)
  verifiedAt    DateTime?     @map("verified_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@unique([bankCode, accountNumber], name: "unique_bank_account")
  @@map("seller_bank_accounts")
  @@index([sellerId])
  @@index([accountNumber])
}

model PlatformSetting {
  key         String   @id
  value       String   // JSON string
  description String?
  updatedBy   String?  @map("updated_by")
  updatedAt   DateTime @default(now()) @map("updated_at")

  @@map("platform_settings")
}

model PlatformSettingAudit {
  id        String   @id @default(cuid())
  key       String
  oldValue  String?  @map("old_value")
  newValue  String   @map("new_value")
  changedBy String?  @map("changed_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("platform_settings_audit")
  @@index([key])
  @@index([createdAt])
}

model Conversation {
  id            String        @id @default(cuid())
  buyerId       String
  buyer         User          @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  vendorId      String
  vendor        VendorProfile @relation("VendorConversations", fields: [vendorId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  lastMessage   String?
  lastMessageAt DateTime      @default(now())
  messages      ChatMessage[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([buyerId, vendorId, productId])
  @@index([buyerId])
  @@index([vendorId])
  @@index([lastMessageAt])
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("UserSentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // CHAT_MESSAGE | ORDER_CREATED | ORDER_STATUS | ESCROW_RELEASED | SYSTEM
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model AmbassadorProfile {
  id                String            @id @default(cuid())
  userId            String            @unique
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  campusId          String
  campus            Campus            @relation(fields: [campusId], references: [id])
  referralCode      String            @unique
  status            AmbassadorStatus  @default(ACTIVE)
  bio               String?
  whatsapp          String?
  bankAccountName   String?
  bankAccountNumber String?
  bankCode          String?
  bankName          String?
  bankResolvedName  String?
  bankVerified      Boolean           @default(false)
  
  totalClicks       Int               @default(0)
  totalEarnings     Float             @default(0.0)
  paidEarnings      Float             @default(0.0)
  pendingEarnings   Float             @default(0.0)

  referrals         Referral[]
  payouts           AmbassadorPayout[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([referralCode])
  @@index([campusId])
  @@index([status])
}

model Referral {
  id              String                @id @default(cuid())
  ambassadorId    String
  ambassador      AmbassadorProfile     @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)
  referredUserId  String                @unique
  referredUser    User                  @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  roleAtSignup    String                @default("BUYER") // "BUYER" | "VENDOR"
  isQualified     Boolean               @default(false)   // Vendor listed item or completed activity
  rewardAmount    Float                 @default(0.0)
  rewardStatus    ReferralRewardStatus  @default(PENDING)
  notes           String?
  createdAt       DateTime              @default(now())

  @@index([ambassadorId])
  @@index([rewardStatus])
  @@index([roleAtSignup])
}

model AmbassadorPayout {
  id              String            @id @default(cuid())
  ambassadorId    String
  ambassador      AmbassadorProfile @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)
  amount          Float
  reference       String            @unique
  status          String            @default("PENDING") // PENDING, SUCCESSFUL, FAILED
  bankDetails     String?           // JSON snapshot: bankName, accountNum, accountName
  notes           String?
  processedBy     String?           // Admin User ID
  processedAt     DateTime?
  createdAt       DateTime          @default(now())

  @@index([ambassadorId])
  @@index([status])
}

model Promotion {
  id            String            @id @default(cuid())
  productId     String
  product       Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendorId      String
  vendor        VendorProfile     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  discountType  PromoDiscountType @default(PERCENTAGE)
  discountValue Float
  promoPrice    Float
  startAt       DateTime
  endAt         DateTime
  label         String?
  status        PromoStatus       @default(SCHEDULED)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([productId])
  @@index([vendorId])
  @@index([status])
  @@index([startAt, endAt])
  @@index([productId, status])
}

model Coupon {
  id              String             @id @default(cuid())
  code            String             @unique
  type            String             @default("free_access")
  maxRedemptions  Int                @default(50)
  freePeriodDays  Int                @default(180)
  inactivityDays  Int                @default(60)
  isActive        Boolean            @default(true)
  expiresAt       DateTime?
  createdBy       String
  updatedBy       String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  redemptions     CouponRedemption[]
  auditLogs       CouponAuditLog[]

  @@index([code])
  @@index([isActive])
}

model CouponRedemption {
  id                      String                 @id @default(cuid())
  couponId                String
  coupon                  Coupon                 @relation(fields: [couponId], references: [id], onDelete: Cascade)
  vendorId                String
  vendor                  VendorProfile          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  status                  CouponRedemptionStatus @default(ACTIVE)
  redeemedAt              DateTime               @default(now())
  accessExpiresAt         DateTime
  releasedAt              DateTime?
  releaseReason           CouponReleaseReason?
  warningSentAt           DateTime?
  inactivityWarningSentAt DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@unique([couponId, vendorId])
  @@index([vendorId])
  @@index([status])
  @@index([accessExpiresAt])
}

model CouponAuditLog {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action    String
  oldValue  String?
  newValue  String?
  metadata  String?
  createdAt DateTime @default(now())

  @@index([couponId])
  @@index([actorId])
  @@index([createdAt])
}

// ----------------------------------------------------
// TRANSACTIONAL & MARKETING EMAIL SYSTEM MODELS
// ----------------------------------------------------

model EmailQueue {
  id           String    @id @default(cuid())
  recipient    String
  subject      String
  templateId   String
  payloadJson  String    // JSON stringified variables for template
  priority     String    @default("NORMAL") // HIGH | NORMAL | LOW
  status       String    @default("PENDING") // PENDING | PROCESSING | SENT | FAILED
  attempts     Int       @default(0)
  maxAttempts  Int       @default(5)
  nextRetryAt  DateTime? @default(now())
  error        String?
  metadataJson String?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, nextRetryAt])
  @@index([recipient])
  @@index([createdAt])
}

model EmailLog {
  id                String   @id @default(cuid())
  recipient         String
  subject           String
  templateId        String
  status            String   // SENT | FAILED | SIMULATED | BOUNCED
  providerMessageId String?
  error             String?
  metadataJson      String?
  sentAt            DateTime @default(now())
  createdAt         DateTime @default(now())

  @@index([recipient])
  @@index([templateId])
  @@index([status])
  @@index([createdAt])
}

model EmailSuppression {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String   // BOUNCE | COMPLAINT | MANUAL | UNSUBSCRIBE
  details   String?
  createdAt DateTime @default(now())

  @@index([email])
}

model EmailPreference {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketingEmails  Boolean  @default(true)
  orderUpdates     Boolean  @default(true)
  securityAlerts   Boolean  @default(true)
  cartReminders    Boolean  @default(true)
  adminDigestMode  String   @default("INSTANT") // INSTANT | DIGEST | OFF
  unsubscribeToken String   @unique @default(cuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([unsubscribeToken])
}



