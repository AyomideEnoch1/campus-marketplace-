# ==============================================================================
# CAMPUSTRADE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure with your actual project credentials.
# NEVER commit .env to version control or expose production secrets.
# ==============================================================================

# Database Connection (Supabase PostgreSQL / Direct URL)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Auth & Storage API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

# JWT Secret for Session Management (Minimum 32 random characters)
JWT_SECRET="super-secret-jwt-key-replace-in-production-min-32-chars"

# App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Flutterwave v3 API Credentials
# Get these from your Flutterwave Dashboard -> Settings -> API Keys
FLW_PUBLIC_KEY="FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X"
FLW_SECRET_KEY="FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X"
FLW_ENCRYPTION_KEY="FLWSECK_TESTxxxxxxxx"

# Flutterwave Webhook Secret Hash
# Set this secret hash in Flutterwave Dashboard -> Settings -> Webhooks, and match it here
FLW_SECRET_HASH="your_secure_custom_webhook_secret_hash_here"

# Flutterwave Offline / Mock Development Mode
# Set to "true" to run automated tests offline without real API keys
MOCK_FLUTTERWAVE="false"

# Background Job / Cron Authentication Secret
# Protects GET/POST /api/escrow/cron-auto-release endpoint (Minimum 32 random characters)
CRON_SECRET="your-secure-random-cron-secret-min-32-chars-replace-in-production"

# Resend Email Service
RESEND_API_KEY="re_your_resend_api_key_here"
EMAIL_FROM="CampusTrade <notifications@campustrade.ng>"

# Admin Initial Seed Credentials
ADMIN_EMAIL="admin@campustrade.ng"
ADMIN_PASSWORD="AdminPassword123!"
