# Database connection (Supabase PostgreSQL / Direct URL)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Auth & Storage API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# JWT Secret for fallback/server sessions
JWT_SECRET="super-secret-jwt-key-replace-in-production-min-32-chars"

# App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin Initial Seed Credentials
ADMIN_EMAIL="admin@campustrade.ng"
ADMIN_PASSWORD="AdminPassword123!"
